# OpenClaw DigitalOcean Environment Configuration Template
# This file documents the required environment variables for DO deployment
# Copy this to .env on your droplet and fill in actual values
# DO NOT commit .env to version control

# OpenClaw Configuration
NODE_ENV=production
OPENCLAW_PORT=18789

# LLM Configuration
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENCLAW_MODEL=anthropic/claude-sonnet-4-5-20250929

# OpenRouter (for Kimi model + Perplexity web search)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# NVIDIA (hosted NIM / Integrate API - optional fallback)
NVIDIA_API_KEY=nvapi-your-key-here

# Email Credentials (Proton Mail)
PROTON_EMAIL=your-email@proton.me
PROTON_PASSWORD=your-proton-password-here

# Security
SESSION_SECRET=generate-with-openssl-rand-base64-32
OPENCLAW_GATEWAY_TOKEN=generate-with-openssl-rand-hex-32
