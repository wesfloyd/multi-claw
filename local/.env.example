# OpenClaw Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Anthropic API Key (for hosted Claude models)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Ollama Configuration (local models)
OLLAMA_API_KEY=ollama-local
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# OpenClaw Gateway
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=generate-with-openssl-rand-hex-32

# DigitalOcean (prod droplet)
DROPLET_IP=your-droplet-ip-here

# NVIDIA (hosted NIM / Integrate API)
NVIDIA_API_KEY=nvapi-your-key-here

# Email Credentials (Proton Mail)
PROTON_EMAIL=your-email@proton.me
PROTON_PASSWORD=your-proton-password-here

# OpenClaw Home Volume (optional - defaults to ~/.openclaw/)
# OPENCLAW_HOME_VOLUME=openclaw_home
